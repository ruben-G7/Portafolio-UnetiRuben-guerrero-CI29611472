  <style>
    :root {
      --bg: #06101e;
      --surface: #0c1c32;
      --surface-2: #122744;
      --border: rgba(56, 189, 248, 0.22);
      --text: #eaf4ff;
      --muted: #a6bdd4;
      --accent: #38bdf8;
      --accent-2: #22d3ee;
      --ok: #34d399;
      --warn: #fbbf24;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: radial-gradient(circle at 80% 0%, #113058 0%, var(--bg) 55%);
      color: var(--text);
      line-height: 1.62;
    }

    header.topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(6, 16, 30, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      padding: 0.85rem 1.5rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.9rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      font-weight: 700;
      font-size: 0.98rem;
    }

    .brand-badge {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #03101d;
      font-weight: 800;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      font-size: 0.82rem;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    nav a, button.btn {
      text-decoration: none;
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.45rem 0.8rem;
      border-radius: 8px;
      font-size: 0.88rem;
      cursor: pointer;
      transition: 0.2s ease;
    }

    nav a:hover, button.btn:hover {
      border-color: var(--accent-2);
      background: var(--surface-2);
    }

    button.btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #03101d;
      font-weight: 700;
      border: none;
    }

    main {
      max-width: 1140px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.6rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
    }

    .hero {
      display: grid;
      grid-template-columns: 1.38fr 0.82fr;
      gap: 1.75rem;
      align-items: start;
    }

    .tag {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.4px;
      color: var(--accent-2);
      background: rgba(34, 211, 238, 0.12);
