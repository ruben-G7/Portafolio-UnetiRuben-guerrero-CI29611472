      text-align: left;
      font-size: 0.9rem;
      margin-top: 0.85rem;
    }

    .meta-list li {
      padding: 0.38rem 0;
      border-bottom: 1px dashed rgba(166, 189, 212, 0.16);
    }

    .vn-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: 0.7rem;
      margin-top: 0.65rem;
    }

    .vn-node {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.85rem;
      text-align: left;
      color: var(--text);
      cursor: pointer;
      transition: 0.2s;
