    .table-wrap { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.9rem 0 1.2rem;
      font-size: 0.9rem;
    }

    th, td {
      border: 1px solid var(--border);
      padding: 0.68rem 0.78rem;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: var(--surface-2);
      color: var(--accent-2);
      font-weight: 700;
    }

    .eq-block {
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(56, 189, 248, 0.14);
